{
  "manifest_version": 3,
  "name": "Timesheet",
  "description": "Quick timer start/stop for the Timesheet app.",
  "version": "0.1.0",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icon-16.png",
      "48": "public/icon-48.png",
      "128": "public/icon-128.png"
    }
  },
  "icons": {
    "16": "public/icon-16.png",
    "48": "public/icon-48.png",
    "128": "public/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "commands": {
    "toggle-timer": {
      "suggested_key": { "default": "Ctrl+Shift+U" },
      "description": "Start/stop the current timer"
    }
  },
  "permissions": ["storage", "alarms", "idle", "notifications", "contextMenus"],
  "host_permissions": ["https://*.supabase.co/*"]
}
